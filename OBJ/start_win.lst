1004          void win_init(void)
1005          {
1006   1      
1007   1        u16 xdata init_flag;
1008   1        u16 xdata flag;
1009   1        memset(&win_str_data,0,sizeof(win_str_data));
1010   1        
1011   1      //init workbence para
1012   1      //read from flash///////////////////////////////////////////
1013   1        Init_read_norflash();
1014   1        if(win_str_data.product_id >= PRODUCT_TOTAL) win_str_data.product_id = 0;
1015   1      
1016   1      //2.load system parametes settings
1017   1        win_load_setpara();
1018   1      //3 service time
1019   1      
1020   1      //4 program group
1021   1        Prog_mode_para_read();
1022   1      //3 service time
1023   1        win_str_data.used_time = win_str_data.used_time_h;
1024   1        win_str_data.used_time <<= 16;
1025   1        win_str_data.used_time |= win_str_data.used_time_l;
1026   1        win_str_data.disp_time = win_str_data.used_time/3600;  //小时数
1027   1      
1028   1        init_flag = 0;
1029   1        norflash_read(FACTORY_PARAMS_INIT_FLAG_ADDR,(u8*)&init_flag,2);  // Read 2 bytes
1030   1        
1031   1        if(init_flag == FACTORY_PARAMS_INIT_VALUE)
1032   1        {
1033   2          // Parameters have been initialized and saved, load from Flash
1034   2          norflash_read(PRE_RELIEF_TIME_ADDR,(u8*)&win_str_data.pressure_relief_time,4);
1035   2          if(win_str_data.pressure_relief_time < 1 || win_str_data.pressure_relief_time > 99)
1036   2            win_str_data.pressure_relief_time = 45;  // Safety check: invalid saved value
1037   2          
1038   2          if(win_str_data.sampling_time < 1 || win_str_data.sampling_time > 99)
1039   2            win_str_data.sampling_time = 50;  // Safety check: invalid saved value
1040   2      
1041   2          if(win_str_data.mold_pressing1 < 1 || win_str_data.mold_pressing1 > 400)
1042   2            win_str_data.mold_pressing1 = 400;  // Safety check: invalid saved value
1043   2      
1044   2          if(win_str_data.mold_pressing2 < 1 || win_str_data.mold_pressing2 > 400)
1045   2            win_str_data.mold_pressing2 = 150;  // Safety check: invalid saved value
1046   2        }
1047   1        else
1048   1        {
1049   2          // First boot: use factory default values and mark as initialized
1050   2          win_str_data.pressure_relief_time = 45;   // Default: 45S pressure relief time
1051   2          win_str_data.sampling_time = 50;          // Default: 50S sampling time
1052   2          win_str_data.mold_pressing1 = 400;        // Default: 40T mold pressing1
1053   2          win_str_data.mold_pressing2 = 150;        // Default: 15T mold pressing2
1054   2          
1055   2          // Save defaults to Flash for first time
1056   2          flag = FACTORY_PARAMS_INIT_VALUE;  // Set magic number 0xA5A5
1057   2          norflash_write(FACTORY_PARAMS_INIT_FLAG_ADDR,(u8*)&flag,2);  // Write 2 bytes
1058   2          norflash_write(PRE_RELIEF_TIME_ADDR,(u8*)&win_str_data.pressure_relief_time,4);
1059   2        }
1060   1        sys_write_vp(ARTNUM_BACKEND_PRESSURE_RELIEF_TIME_ADDR,(u8 *)&win_str_data.pressure_relief_time,4);
1061   1      
C51 COMPILER V9.60.7.0   START_WIN                                                         09/20/2026 13:27:30 PAGE 19  

1062   1        win_str_data.sampling_pressing = 10;
1063   1        
1064   1        sys_delay_about_ms(4000);  
1065   1        
1066   1        win_change_page(WORK_PAGE);
1067   1      }


