 272          void disp_input_icon(u16 btn_val)
 273          {
 274   1        u8 offset_table[] = {0, 1, 2, 3};  // 语言对应的偏移量 (CN, EN, RUS, JAPAN)
 275   1        u8 *disp_ptr[] = {
