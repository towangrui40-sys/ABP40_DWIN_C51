 285   1        // 根据按钮值确定要修改的显示索引
 286   1        switch(btn_val)
 287   1        {
 288   2          case  BTN_VAL_STEP1_PRESSURE:  disp_index = 0; break;
 289   2          case  BTN_VAL_STEP2_PRESSURE:  disp_index = 1; break;
