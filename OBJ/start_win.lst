 241          /********************************************************
 242          * Function: disp_input_icon
 243          * Description: Displays the input icon on the screen based on the selected parameter. The function updates
 244          * the display data for the input icon according to the current language setting and the selected parameter
             - (level, total time, run time, or pause time).
 245          * Parameters:
 246          *   btn_val - The value of the button that corresponds to the selected parameter for which the
 247          *********************************************************/
 248          void disp_input_icon(u16 btn_val)
 249          {
 250   1        u8 offset_table[] = {0, 1, 2, 3};  // 语言对应的偏移量 (CN, EN, RUS, JAPAN)
 251   1        u8 *disp_ptr[] = {
 252   1          &win_str_data.input_disp1,
 253   1          &win_str_data.input_disp2,
 254   1          &win_str_data.input_disp3,
 255   1          &win_str_data.input_disp4,
 256   1          &win_str_data.input_disp5,
 257   1          &win_str_data.input_disp6,
 258   1        };
 259   1        u8 disp_index;
 260   1        
 261   1        // 根据按钮值确定要修改的显示索引
 262   1        switch(btn_val)
 263   1        {
 264   2          case  BTN_VAL_STEP1_PRESSURE:  disp_index = 0; break;
 265   2          case  BTN_VAL_STEP2_PRESSURE:  disp_index = 1; break;
 266   2          case  BTN_VAL_STEP3_PRESSURE:  disp_index = 2; break;
 267   2          case  BTN_VAL_STEP1_HOLD_TIME:   disp_index = 3; break;
 268   2          case  BTN_VAL_STEP2_HOLD_TIME:   disp_index = 4; break;
 269   2          case  BTN_VAL_STEP3_HOLD_TIME:   disp_index = 5; break;
 270   2          default: return;
 271   2        }
 272   1        
 273   1        // 根据语言添加偏移量
 274   1        if(win_str_data.language < 4)
 275   1        {
 276   2          *disp_ptr[disp_index] += offset_table[win_str_data.language];
 277   2        }
 278   1        sys_write_vp(ICON_INPUT1_ADDR, (u8 *)&win_str_data.input_disp1, 6);
 279   1        sys_write_vp(ICON_INPUT1_WORD_ADDR, (u8 *)&win_str_data.input_disp1, 6);
 280   1      }
