1062   2          if(win_str_data.sampling_time < 1 || win_str_data.sampling_time > 99)
1063   2            win_str_data.sampling_time = 50;  // Safety check: invalid saved value
1064   2      
1065   2          if(win_str_data.mold_pressing1 < 1 || win_str_data.mold_pressing1 > 400)
1066   2            win_str_data.mold_pressing1 = 400;  // Safety check: invalid saved value
1067   2      
1068   2          if(win_str_data.mold_pressing2 < 1 || win_str_data.mold_pressing2 > 400)
1069   2            win_str_data.mold_pressing2 = 150;  // Safety check: invalid saved value
1070   2        }
1071   1        else
