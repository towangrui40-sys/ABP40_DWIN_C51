1054   1        
1055   1        if(init_flag == FACTORY_PARAMS_INIT_VALUE)
1056   1        {
1057   2          // Parameters have been initialized and saved, load from Flash
1058   2          norflash_read(PRE_RELIEF_TIME_ADDR,(u8*)&win_str_data.pressure_relief_time,4);
1059   2          if(win_str_data.pressure_relief_time < 1 || win_str_data.pressure_relief_time > 99)
1060   2            win_str_data.pressure_relief_time = 45;  // Safety check: invalid saved value
1061   2          
