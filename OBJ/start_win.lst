1100   2            win_str_data.sampling_time = 50;  // Safety check: invalid saved value
1101   2      
1102   2          if(win_str_data.mold_pressing1 < 1 || win_str_data.mold_pressing1 > 400)
1103   2            win_str_data.mold_pressing1 = 400;  // Safety check: invalid saved value
1104   2      
1105   2          if(win_str_data.mold_pressing2 < 1 || win_str_data.mold_pressing2 > 400)
1106   2            win_str_data.mold_pressing2 = 150;  // Safety check: invalid saved value
1107   2        }
1108   1        else
1109   1        {
1110   2          // First boot: use factory default values and mark as initialized
1111   2          win_str_data.pressure_relief_time = 45;   // Default: 45S pressure relief time
1112   2          win_str_data.sampling_time = 50;          // Default: 50S sampling time
1113   2          win_str_data.mold_pressing1 = 400;        // Default: 40T mold pressing1
1114   2          win_str_data.mold_pressing2 = 150;        // Default: 15T mold pressing2
1115   2          
1116   2          // Save defaults to Flash for first time
1117   2          flag = FACTORY_PARAMS_INIT_VALUE;  // Set magic number 0xA5A5
1118   2          norflash_write(FACTORY_PARAMS_INIT_FLAG_ADDR,(u8*)&flag,2);  // Write 2 bytes
1119   2          norflash_write(PRE_RELIEF_TIME_ADDR,(u8*)&win_str_data.pressure_relief_time,4);
1120   2        }
